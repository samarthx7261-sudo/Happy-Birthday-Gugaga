import time
import os
import math

WIDTH, HEIGHT = 60, 25

def generate_frame(t):
    output = []
    for y in range(HEIGHT):
        row = []
        for x in range(WIDTH):
            nx = (x - WIDTH / 2) / (WIDTH / 5)
            ny = (y - HEIGHT / 2) / (HEIGHT / 5)
            
            char = " "
            
            # 1. Plate formation phase
            if t >= 1:
                plate_progress = min(1.0, (t - 1) / 1.5)
                if abs(ny - 1.2) < 0.25 and abs(nx) < 1.8 * plate_progress:
                    char = "=" if ny > 1.2 else "_"

            # 2. Cake rising from bottom
            if t >= 2.5:
                cake_progress = min(1.0, (t - 2.5) / 2.0)
                cake_top = 1.2 - (2.2 * cake_progress)
                if cake_top <= ny <= 1.2 and abs(nx) < 1.1:
                    if int(nx * 8) % 2 == 0:
                        char = "#"
                    elif int(ny * 6) % 3 == 0:
                        char = "~"
                    else:
                        char = "x"

            # 3. Candle and Flame
            if t >= 4.5:
                if 0.5 <= ny <= 1.0 and abs(nx) < 0.15:
                    char = "|"
                if 0.0 <= ny < 0.5 and abs(nx) < 0.25:
                    flicker = math.sin(t * 12 + x)
                    char = "▲" if flicker > 0 else "n"

            # 4. Happy Birthday Text
            if t >= 6.0:
                if -1.8 <= ny <= -1.2:
                    text = " HAPPY BIRTHDAY HG! "
                    idx = int(nx + WIDTH / 4)
                    if 0 <= idx < len(text):
                        char = text[idx]

            row.append(char)
        output.append("".join(row))
    return "\n".join(output)

def main():
    print("Starting ASCII Birthday Animation...")
    time.sleep(1)
    
    for i in range(75):
        t = i * 0.1
        os.system('cls' if os.name == 'nt' else 'clear')
        print(f"Time: {t:.1f}s")
        print("-" * WIDTH)
        print(generate_frame(t))
        print("-" * WIDTH)
        time.sleep(0.08)
        
    print("\n🎉✨ HAPPY BIRTHDAY HG! ✨🎉")

if __name__ == "__main__":
    main()
